<section class="card">
    <h2>Detalle de la Reserva #<%= reserva.id %></h2>
    <hr style="margin: 1rem 0; border: 0; border-top: 1px solid var(--border-color);">

    <p><strong>Estudiantes:</strong> <%= reserva.estudiante %></p>
    <p><strong>Correo Electronico:</strong> <%= reserva.email %></p>
    <p><strong>Sala Asignada:</strong> <%= reserva.sala %></p>
    <p><strong>Fecha:</strong> <%= reserva.fecha %></p>
    <p><strong>Turno:</strong> <%= reserva.turno %></p>
    <p><strong>Cantidad de Personas:</strong> <%= reserva.personas %></p>

    <div style="margin-top: 1.5rem;">
        <a href="/reservas" class="btn">Volver al Listado</a>
    </div>
</section>